<div class="readonly-field @(Variant == Variant.Outlined ? "readonly-field--outlined" : "readonly-field--text") @(Dense ? "readonly-field--dense" : "") @Class" style="@Style">
    <span class="readonly-field__label">@Label</span>
    <div class="readonly-field__content">
        @if (CheckBox)
        {
            <MudIcon Icon="@(Convert.ToBoolean(Value) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Cancel)"
                     Color="@(Convert.ToBoolean(Value) ? Color.Success : Color.Default)"
                     Size="Size.Small" />
        }
        else if (IsEmpty)
        {
            <span class="readonly-field__empty">—</span>
        }
        else if (Value is IEnumerable<object> enumerable)
        {
            <div class="readonly-field__chips">
                @foreach (var item in enumerable)
                {
                    <MudChip T="string" Variant="Variant.Text" Size="Size.Small">@item</MudChip>
                }
            </div>
        }
        else
        {
            <span class="readonly-field__value">@Value</span>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? Label { get; set; }
    
    [Parameter]
    public object? Value { get; set; }
    
    [Parameter]
    public bool CheckBox { get; set; }
    
    [Parameter]
    public bool Dense { get; set; } = false;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Text;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }

    private bool IsEmpty => Value == null || string.IsNullOrWhiteSpace(Value.ToString());
}
