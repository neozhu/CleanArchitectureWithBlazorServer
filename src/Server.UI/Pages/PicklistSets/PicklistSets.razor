@page "/system/picklistset"
@using CleanArchitecture.Blazor.Application.Features.PicklistSets.DTOs
@using CleanArchitecture.Blazor.Application.Features.PicklistSets.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.PicklistSets.Queries.PaginationQuery
@using CleanArchitecture.Blazor.Application.Features.PicklistSets.Caching
@using CleanArchitecture.Blazor.Application.Features.PicklistSets.Commands.AddEdit
@using CleanArchitecture.Blazor.Application.Features.PicklistSets.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.PicklistSets.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.PicklistSets.Specifications
@using CleanArchitecture.Blazor.Server.UI.Pages.PicklistSets.Components

@attribute [Authorize(Policy = Permissions.PicklistSets.View)]
@inject IStringLocalizer<PicklistSets> L
@inject BlazorDownloadFileService BlazorDownloadFileService

<PageTitle>@Title</PageTitle>

<MudPaper Class="page-card" Elevation="0">
    <header class="page-card__header d-flex flex-column flex-sm-row align-start justify-space-between gap-4">
        <div class="page-card__heading">
            <div class="page-card__breadcrumb d-flex align-center">
                <MudBreadcrumbs Items="_breadcrumbItems">
                    <SeparatorTemplate>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                    </SeparatorTemplate>
                </MudBreadcrumbs>
            </div>
            <MudText Typo="Typo.h4">@L[SelectedItem.GetClassDescription()]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                @L["Manage system picklists, lookup values, and dictionary entries."]
            </MudText>
        </div>

        <div class="d-flex flex-wrap align-center justify-start justify-sm-end gap-2">
            <MudButton Variant="Variant.Outlined" Disabled="@_loading" OnClick="OnRefresh"
                       StartIcon="@Icons.Material.Outlined.Refresh">@AppStrings.Refresh</MudButton>

            @if (_accessRights.Create)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                           OnClick="OnCreate">@AppStrings.New</MudButton>
            }
            @if (_accessRights.Export)
            {
                <MudButton Variant="Variant.Outlined" Disabled="@_exporting" OnClick="OnExport"
                           StartIcon="@Icons.Material.Outlined.Download">@AppStrings.Export</MudButton>
            }
            <MudMenu TransformOrigin="Origin.TopRight" AnchorOrigin="Origin.BottomRight"
                     Icon="@Icons.Material.Filled.MoreHoriz" AriaLabel="@AppStrings.More">
                @if (_accessRights.Delete)
                {
                    <MudMenuItem Disabled="@(_selectedItems.Count == 0)" OnClick="OnDeleteChecked">@AppStrings.Delete</MudMenuItem>
                }
                @if (_accessRights.Import)
                {
                    <MudMenuItem>
                        <MudFileUpload T="IBrowserFile" FilesChanged="OnImportData" Accept=".xlsx">
                            <CustomContent>
                                <MudButton Class="pa-0 ma-0"
                                           OnClick="@context.OpenFilePickerAsync"
                                           Style="font-weight:400;text-transform:none;"
                                           Variant="Variant.Text"
                                           Disabled="@_uploading">
                                    @AppStrings.Import
                                </MudButton>
                            </CustomContent>
                            <SelectedTemplate></SelectedTemplate>
                        </MudFileUpload>
                    </MudMenuItem>
                }
            </MudMenu>
        </div>
    </header>

    <section class="page-card__filter-region" aria-label="@L["Picklist filters"]">
        <div class="page-card__filters d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
            <MudEnumSelect Class="page-card__view-select" TEnum="PickListView" Value="_picklistQuery.ListView"
                           ValueChanged="OnChangedListView" Dense="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.FilterList"
                           Label="@L["List View"]">
            </MudEnumSelect>
            @if (_accessRights.Search)
            {
                <MudEnumSelect TEnum="Picklist?" Class="page-card__view-select"
                               Placeholder="@L["Search by picklist"]" Value="@_searchPicklist" Clearable="true"
                               ValueChanged="OnPicklistSearch" Dense="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.BookmarkBorder"
                               Label="@L["Picklist"]" />
                <MudTextField T="string" Class="page-card__search"
                              Value="@_picklistQuery.Keyword" ValueChanged="OnKeywordSearch"
                              Placeholder="@AppStrings.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small" />
            }
        </div>
    </section>

    <MudDataGrid @ref="_table" FixedHeader="true"
                 Elevation="0"
                 FixedFooter="false"
                 @bind-RowsPerPage="_defaultPageSize"
                 Hover="true"
                 MultiSelection="true"
                 @bind-SelectedItems="_selectedItems"
                 ReadOnly="false"
                 EditMode="DataGridEditMode.Cell"
                 T="PicklistSetDto"
                 CommittedItemChanges="@CommittedItemChanges"
                 ServerData="ServerReload">
        <Columns>
            <SelectColumn ShowInFooter="false" />
            <PropertyColumn Property="x => x.Name" Title="@L[SelectedItem.GetMemberDisplayName(x => x.Name)]">
                <EditTemplate>
                    <MudEnumSelect @bind-Value="@context.Item.Name" TEnum="Picklist" Placeholder="@L["Select picklist name"]" Required="true">
                    </MudEnumSelect>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Value" Title="@L[SelectedItem.GetMemberDisplayName(x => x.Value)]" />
            <PropertyColumn Property="x => x.Text" Title="@L[SelectedItem.GetMemberDisplayName(x => x.Text)]" />
            <PropertyColumn Property="x => x.Description" Title="@L[SelectedItem.GetMemberDisplayName(x => x.Description)]" />
            <TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Delete" Sortable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Outlined" Color="Color.Error" aria-label="@AppStrings.Delete" Disabled="@(!_accessRights.Delete)" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item))" />
                </CellTemplate>
                <EditTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Outlined" Color="Color.Error" aria-label="@AppStrings.Delete" Disabled="@(!_accessRights.Delete)" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item))" />
                </EditTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudDataGridStatus Icon="@Icons.Material.TwoTone.ListAlt"
                               Text="@L["No Picklist Items Found"]"
                               SubText="@L["Try adjusting your search or filter to find what you're looking for."]" />
        </NoRecordsContent>
        <LoadingContent>
            <MudDataGridStatus IsLoading="true"
                               Text="@L["Loading Picklist Items..."]" />
        </LoadingContent>
        <PagerContent>
            <MudDataGridPager PageSizeOptions="@(new[] { 10, 15, 30, 50, 100, 500, 1000 })" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
    #region Fields & Properties

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private UserProfile UserProfile => UserProfileState.Value;
    private MudDataGrid<PicklistSetDto> _table = null!;
    public string Title { get; set; } = "Picklist";
    private List<BreadcrumbItem> _breadcrumbItems = [];
    private IList<PicklistSetDto> _keyValueList = new List<PicklistSetDto>();
    private HashSet<PicklistSetDto> _selectedItems = new();
    private PicklistSetDto SelectedItem { get; set; } = new();
    private PicklistSetDto ElementBeforeEdit { get; set; } = new();

    private string _searchString = string.Empty;
    private Picklist? _searchPicklist;
    private int _defaultPageSize = 15;

    private PicklistSetsWithPaginationQuery _picklistQuery { get; set; } = new();
    private PicklistSetsAccessRights _accessRights = new();


    private bool _loading;
    private bool _uploading;
    private bool _exporting;

    #endregion



    protected override async Task OnInitializedAsync()
    {
        Title = $"{ApplicationSettings.AppName} - {L[SelectedItem.GetClassDescription()]}";
        _breadcrumbItems =
        [
            new BreadcrumbItem(L["Application"], href: null),
            new BreadcrumbItem(L["System"], href: null),
            new BreadcrumbItem(L[SelectedItem.GetClassDescription()], href: null, disabled: true)
        ];
        _accessRights = await PermissionService.GetAccessRightsAsync<PicklistSetsAccessRights>();
    }



    #region Grid Data & Search

    private async Task<GridData<PicklistSetDto>> ServerReload(GridState<PicklistSetDto> state, CancellationToken cancellationToken)
    {
        try
        {
            _loading = true;
            _picklistQuery.CurrentUser = UserProfile;
            _picklistQuery.Keyword = _searchString;
            _picklistQuery.Picklist = _searchPicklist;
            _picklistQuery.OrderBy = state.SortDefinitions.FirstOrDefault()?.SortBy ?? "Id";
            var sortDefinition = state.SortDefinitions.FirstOrDefault();
            _picklistQuery.SortDirection = sortDefinition == null
                                      ? SortDirection.Descending.ToString()
                                      : (sortDefinition.Descending ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString());
            _picklistQuery.PageNumber = state.Page + 1;
            _picklistQuery.PageSize = state.PageSize;
            var result = await Mediator.Send(_picklistQuery);
            return new GridData<PicklistSetDto> { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnChangedListView(PickListView listview)
    {
        _picklistQuery.ListView = listview;
        await _table.ReloadServerData();
    }

    private async Task OnKeywordSearch(string text)
    {
        _searchString = text;
        await _table.ReloadServerData();
    }

    private async Task OnPicklistSearch(Picklist? val)
    {
        _searchPicklist = val;
        await _table.ReloadServerData();
    }

    private async Task OnRefresh()
    {
        await AppCache.RemoveByTagsAsync(PicklistSetCacheKey.Tags);
        _searchString = string.Empty;
        await InvokeAsync(() => _table.ReloadServerData());
    }

    #endregion

    #region Edit & Commit Changes

     

    private Task<DataGridEditFormAction> CommittedItemChanges(PicklistSetDto item)
    {
        InvokeAsync(async () =>
        {
            var command = ObjectMapper.Map<AddEditPicklistSetCommand>(item);
            var result = await Mediator.Send(command);
            if (!result.Succeeded)
            {
                Snackbar.Add(result.ErrorMessage, Severity.Error);
            }
            StateHasChanged();
        });
        return Task.FromResult(DataGridEditFormAction.Close);
    }

    #endregion

    #region Create & Delete

    private Task OnCreate()
    {
        var command = new AddEditPicklistSetCommand
        {
            Name = SelectedItem.Name,
            Description = SelectedItem?.Description
        };
        return DialogServiceHelper.ShowFormDialogAsync<CreatePicklistDialog, AddEditPicklistSetCommand>(
                L["Create a picklist"],
                async (res) =>
            {
                await _table.ReloadServerData();
                _selectedItems = new HashSet<PicklistSetDto>();
            },
            para =>
            {
                para.Add(x => x._model, command);
            });
         
    }

    private async Task DeleteItem(PicklistSetDto item)
    {
        var command = new DeletePicklistSetCommand(new[] { item.Id });
        var contentText = string.Format(AppStrings.DeleteConfirmation, item.Name);
        await DialogServiceHelper.ShowDeleteConfirmationDialogAsync(command, AppStrings.DeleteConfirmationTitle, contentText, async () =>
        {
            await InvokeAsync(async () =>
            {
                await _table.ReloadServerData();
                _selectedItems = new HashSet<PicklistSetDto>();
            });
        });
    }

    private async Task OnDeleteChecked()
    {
        var command = new DeletePicklistSetCommand(_selectedItems.Select(x => x.Id).ToArray());
        var contentText = string.Format(AppStrings.DeleteConfirmation, _selectedItems.Count);
        await DialogServiceHelper.ShowDeleteConfirmationDialogAsync(command, AppStrings.DeleteConfirmationTitle, contentText, async () =>
        {
            await InvokeAsync(async () =>
            {
                await _table.ReloadServerData();
                _selectedItems = new HashSet<PicklistSetDto>();
            });
        });
    }

    #endregion

    #region Export & Import

    private async Task OnExport()
    {
        _exporting = true;
        try
        {
            var request = new ExportPicklistSetsQuery { Keyword = _searchString };
            var result = await Mediator.Send(request);
            await BlazorDownloadFileService.DownloadFileAsync($"{L["Picklist"]}.xlsx", result, "application/octet-stream");
            Snackbar.Add(AppStrings.ExportSuccess, Severity.Info);
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task OnImportData(IBrowserFile file)
    {
        _uploading = true;
        try
        {
            using var stream = new MemoryStream();
            await file.OpenReadStream(GlobalVariables.MaxAllowedSize).CopyToAsync(stream);
            var command = new ImportPicklistSetsCommand(file.Name, stream.ToArray());
            var result = await Mediator.Send(command);
            if (result.Succeeded)
            {
                await OnRefresh();
                Snackbar.Add(AppStrings.ImportSuccess, Severity.Info);
            }
            else
            {
                foreach (var msg in result.Errors)
                {
                    Snackbar.Add(msg, Severity.Error);
                }
            }
        }
        finally
        {
            _uploading = false;
        }
    }

    #endregion
}
