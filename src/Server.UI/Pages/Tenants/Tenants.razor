@page "/system/tenants"
@using CleanArchitecture.Blazor.Application.Features.Tenants.DTOs
@using CleanArchitecture.Blazor.Application.Features.Tenants.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.Tenants.Caching
@using CleanArchitecture.Blazor.Application.Features.Tenants.Commands.AddEdit
@using CleanArchitecture.Blazor.Application.Features.Tenants.Commands.Delete

@attribute [Authorize(Policy = Permissions.Tenants.View)]
@inject IStringLocalizer<Tenants> L

<PageTitle>@Title</PageTitle>

<MudPaper Class="page-card" Elevation="0">
	<header class="page-card__header d-flex flex-column flex-sm-row align-start justify-space-between gap-4">
		<div class="page-card__heading">
			<div class="page-card__breadcrumb d-flex align-center">
				<MudBreadcrumbs Items="_breadcrumbItems">
					<SeparatorTemplate>
						<MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
					</SeparatorTemplate>
				</MudBreadcrumbs>
			</div>
			<MudText Typo="Typo.h4">@L[_currentDto.GetClassDescription()]</MudText>
			<MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
				@L["Manage organizational tenants, isolation boundaries, and subscription settings."]
			</MudText>
		</div>

		<div class="d-flex flex-wrap align-center justify-start justify-sm-end gap-2">
			<MudButton Variant="Variant.Outlined" Disabled="@_loading" OnClick="OnRefreshTenants"
					   StartIcon="@Icons.Material.Outlined.Refresh">@AppStrings.Refresh</MudButton>

			@if (_accessRights.Create)
			{
				<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
						   OnClick="OnCreateTenant">@AppStrings.New</MudButton>
			}
			<MudMenu TransformOrigin="Origin.TopRight" AnchorOrigin="Origin.BottomRight"
					 Icon="@Icons.Material.Filled.MoreHoriz" AriaLabel="@AppStrings.More">
				@if (_accessRights.Delete)
				{
					<MudMenuItem Disabled="@(!_selectedItems.Any())" OnClick="OnDeleteSelectedTenants">@AppStrings.Delete</MudMenuItem>
				}
			</MudMenu>
		</div>
	</header>

	@if (_accessRights.Search)
	{
		<section class="page-card__filter-region" aria-label="@L["Tenant filters"]">
			<div class="page-card__filters d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
				<MudTextField T="string" Class="page-card__search"
							  ValueChanged="OnSearchTenant"
							  Value="@_tenantsQuery.Keyword"
							  Placeholder="@AppStrings.Search"
							  Variant="Variant.Outlined" Margin="Margin.Dense"
							  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
							  IconSize="Size.Small">
				</MudTextField>
			</div>
		</section>
	}

	<MudDataGrid ServerData="@(ServerReload)"
				 Elevation="0"
				 FixedHeader="true"
				 FixedFooter="false"
				 Loading="@_loading"
				 @bind-RowsPerPage="_defaultPageSize"
				 MultiSelection="true"
				 @bind-SelectedItems="_selectedItems"
				 Hover="true" @ref="_tenantGrid">
		<Columns>
			<SelectColumn ShowInFooter="false"></SelectColumn>
			<TemplateColumn HeaderStyle="width:92px;text-align:right" Title="@AppStrings.Actions" Sortable="false">
				<CellTemplate>
					@if (_accessRights.Edit || _accessRights.Delete)
					{
						<MudMenu Icon="@Icons.Material.Filled.MoreVert"
								 Variant="Variant.Text"
								 Size="Size.Small"
								 Dense="true"
								 AriaLabel="@AppStrings.Actions"
								 AnchorOrigin="Origin.CenterLeft">
							@if (_accessRights.Edit)
							{
								<MudMenuItem OnClick="@(() => OnEditTenant(context.Item))">
									@AppStrings.Edit
								</MudMenuItem>
							}
							@if (_accessRights.Delete)
							{
								<MudMenuItem OnClick="@(() => OnDeleteTenant(context.Item))">
									@AppStrings.Delete
								</MudMenuItem>
							}
						</MudMenu>
					}
					else
					{
						<MudTooltip Text="@AppStrings.NoAllowed" Delay="300">
							<MudIconButton Variant="Variant.Outlined"
										   Disabled="true"
										   Icon="@Icons.Material.Filled.DoNotTouch"
										   Size="Size.Small"
										   Color="Color.Surface">
								@AppStrings.NoAllowed
							</MudIconButton>
						</MudTooltip>
					}
				</CellTemplate>
			</TemplateColumn>
		<PropertyColumn Property="x => x.Name" Title="@L[_currentDto.GetMemberDisplayName(x => x.Name)]">
			<FooterTemplate>
				@L["Selected"]: @_selectedItems.Count
			</FooterTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.Description" Title="@L[_currentDto.GetMemberDisplayName(x => x.Description)]">
			<CellTemplate>
				<div class="d-flex flex-column">
					<MudText Typo="Typo.body2" Class="mud-text-secondary">
						@context.Item.Description
					</MudText>
				</div>
			</CellTemplate>
		</PropertyColumn>
	</Columns>
	<NoRecordsContent>
		<MudDataGridStatus Icon="@Icons.Material.TwoTone.Domain"
						   Text="@L["No Tenants Found"]"
						   SubText="@L["Try adjusting your search or filter to find what you're looking for."]" />
	</NoRecordsContent>
	<LoadingContent>
		<MudDataGridStatus IsLoading="true"
						   Text="@L["Loading Tenants..."]" />
	</LoadingContent>

	<PagerContent>
		<MudDataGridPager PageSizeOptions="@(new[] { 10, 15, 30, 50, 100, 500, 1000 })" />
	</PagerContent>
</MudDataGrid>
</MudPaper>

@code {


	// Public property for page title
	public string? Title { get; private set; }

	// Private fields
	private int _defaultPageSize = 15;
	private List<BreadcrumbItem> _breadcrumbItems = [];
	private HashSet<TenantDto> _selectedItems = new();
	private MudDataGrid<TenantDto> _tenantGrid = default!;
	private TenantDto _currentDto = new();
	private TenantsAccessRights _accessRights = new();
	private string _searchString = string.Empty;
	private bool _loading;

	// Private pagination query (using a uniform naming convention)
	private TenantsWithPaginationQuery _tenantsQuery { get; } = new();

	protected override async Task OnInitializedAsync()
	{
		Title = $"{ApplicationSettings.AppName} - {L[_currentDto.GetClassDescription()]}";
		_breadcrumbItems =
		[
			new BreadcrumbItem(L["Application"], href: null),
			new BreadcrumbItem(L["Authorization"], href: null),
			new BreadcrumbItem(L[_currentDto.GetClassDescription()], href: null, disabled: true)
		];
		_accessRights = await PermissionService.GetAccessRightsAsync<TenantsAccessRights>();
	}

	// Server data loading callback
	private async Task<GridData<TenantDto>> ServerReload(GridState<TenantDto> state, CancellationToken cancellationToken)
	{
		try
		{
			_loading = true;
			_tenantsQuery.Keyword = _searchString;
			var sortDefinition = state.SortDefinitions.FirstOrDefault();
			_tenantsQuery.OrderBy = sortDefinition?.SortBy ?? "Id";
			_tenantsQuery.SortDirection = sortDefinition == null
											? SortDirection.Descending.ToString()
											: (sortDefinition.Descending ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString());
			_tenantsQuery.PageNumber = state.Page + 1;
			_tenantsQuery.PageSize = state.PageSize;
			var result = await Mediator.Send(_tenantsQuery);
			return new GridData<TenantDto> { TotalItems = result.TotalItems, Items = result.Items };
		}
		finally
		{
			_loading = false;
		}
	}

	// Search event handler
	private async Task OnSearchTenant(string text)
	{
		_selectedItems = new HashSet<TenantDto>();
		_searchString = text;
		await _tenantGrid.ReloadServerData();
	}

	// Refresh event handler
	private async Task OnRefreshTenants()
	{
		await AppCache.RemoveByTagsAsync(TenantCacheKey.Tags);
		_selectedItems = new HashSet<TenantDto>();
		_searchString = string.Empty;
		await _tenantGrid.ReloadServerData();
	}

	// Create tenant event handler
	private Task OnCreateTenant()
	{
		return ShowEditTenantDialog(new AddEditTenantCommand(), L["Create a new Tenant"]);
	}

	// Edit tenant event handler
	private Task OnEditTenant(TenantDto dto)
	{
		var command = ObjectMapper.Map<AddEditTenantCommand>(dto);
		return ShowEditTenantDialog(command, L["Edit the Tenant"]);
	}

	// Delete tenant event handler
	private async Task OnDeleteTenant(TenantDto dto)
	{
		var command = new DeleteTenantCommand(new[] { dto.Id });
		var contentText = string.Format(AppStrings.DeleteConfirmationWithId, dto.Id);
		await DialogServiceHelper.ShowDeleteConfirmationDialogAsync(command, L["Delete the Tenant"], contentText, async () =>
		{
			await InvokeAsync(async () =>
			{
				await _tenantGrid.ReloadServerData();
                _selectedItems = new();
			});
		});
	}

	// Delete selected tenants event handler
	private async Task OnDeleteSelectedTenants()
	{
		var command = new DeleteTenantCommand(_selectedItems.Select(x => x.Id).ToArray());
		var contentText = string.Format(AppStrings.DeleteConfirmation, _selectedItems.Count);
		await DialogServiceHelper.ShowDeleteConfirmationDialogAsync(command, L["Delete Selected Tenants"], contentText, async () =>
		{
			await InvokeAsync(async () =>
			{
				await _tenantGrid.ReloadServerData();
                _selectedItems = new();
			});
		});
	}

	// Helper method: Show edit dialog for tenant
	private Task ShowEditTenantDialog(AddEditTenantCommand command, string title)
	{
		return DialogServiceHelper.ShowFormDialogAsync<TenantFormDialog, AddEditTenantCommand>(
			title,
			async (res) =>
			{
				await _tenantGrid.ReloadServerData();
                _selectedItems = new();
			},
			para =>
			{
				para.Add(x => x._model, command);
			},
			new DialogOptions() { MaxWidth = MaxWidth.Small, CloseButton = true });
	}
}
