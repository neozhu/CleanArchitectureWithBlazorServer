@page "/system/audittrails"
@using CleanArchitecture.Blazor.Application.Features.AuditTrails.DTOs
@using CleanArchitecture.Blazor.Application.Features.AuditTrails.Queries.PaginationQuery
@using CleanArchitecture.Blazor.Application.Features.AuditTrails.Specifications
@using CleanArchitecture.Blazor.Application.Features.AuditTrails.Caching
@using CleanArchitecture.Blazor.Domain.Entities
@using CleanArchitecture.Blazor.Server.UI.Components.Time
@using CleanArchitecture.Blazor.Server.UI.Services.JsInterop

@attribute [Authorize(Policy = Permissions.AuditTrails.View)]
@inject IStringLocalizer<AuditTrails> L
<PageTitle>@Title</PageTitle>

<MudPaper Class="page-card" Elevation="0">
	<header class="page-card__header d-flex flex-column flex-sm-row align-start justify-space-between gap-4">
		<div class="page-card__heading">
			<div class="page-card__breadcrumb d-flex align-center">
				<MudBreadcrumbs Items="_breadcrumbItems">
					<SeparatorTemplate>
						<MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
					</SeparatorTemplate>
				</MudBreadcrumbs>
			</div>
			<MudText Typo="Typo.h4">@L[_currentDto.GetClassDescription()]</MudText>
			<MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
				@L["Track historical data modifications, user operations, and audit records."]
			</MudText>
		</div>

		<div class="d-flex flex-wrap align-center justify-start justify-sm-end gap-2">
			<MudButton Variant="Variant.Outlined" Disabled="@_loading" OnClick="OnRefreshAuditTrails"
					   StartIcon="@Icons.Material.Outlined.Refresh">@AppStrings.Refresh</MudButton>
		</div>
	</header>

	<section class="page-card__filter-region" aria-label="@L["Audit trail filters"]">
		<div class="page-card__filters d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
			<MudEnumSelect Class="page-card__view-select"
						   TEnum="AuditTrailListView"
						   ValueChanged="OnListViewChanged"
						   Value="_auditTrailsQuery.ListView"
						   Dense="true"
						   Variant="Variant.Outlined" Margin="Margin.Dense"
						   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.FilterList"
						   Label="@L["List View"]">
			</MudEnumSelect>
			<MudEnumSelect Class="page-card__view-select"
						   TEnum="AuditType?"
						   Placeholder="@L["Search by audit type"]"
						   Value="_auditTrailsQuery.AuditType"
						   Clearable="true"
						   ValueChanged="OnAuditTypeSearch"
						   Dense="true"
						   Variant="Variant.Outlined" Margin="Margin.Dense"
						   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Category"
						   Label="@L["Audit Type"]">
			</MudEnumSelect>
			<MudTextField T="string" Class="page-card__search"
						  Value="_auditTrailsQuery.Keyword"
						  ValueChanged="OnKeywordSearch"
						  Placeholder="@AppStrings.Search"
						  Variant="Variant.Outlined" Margin="Margin.Dense"
						  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
						  IconSize="Size.Small">
			</MudTextField>
		</div>
	</section>

	<MudDataGrid ServerData="@(ServerReload)"
				 Elevation="0"
				 T="AuditTrailDto"
				 FixedHeader="true"
				 FixedFooter="false"
				 @bind-RowsPerPage="_defaultPageSize"
				 Loading="@_loading"
				 Hover="true" @ref="_auditTrailGrid">
	<Columns>
		<HierarchyColumn T="AuditTrailDto" ButtonDisabledFunc="@(x => x.AuditType == AuditType.None)" />
		<PropertyColumn Property="x => x.TableName" Title="@L[_currentDto.GetMemberDisplayName(x => x.TableName)]" />
		<PropertyColumn Property="x => x.AuditType" Title="@L[_currentDto.GetMemberDisplayName(x => x.AuditType)]" />
		<PropertyColumn Property="x => x.PrimaryKey" Title="@L[_currentDto.GetMemberDisplayName(x => x.PrimaryKey)]">
			<CellTemplate>
				@if (context.Item.PrimaryKey != null)
				{
					@foreach (var kv in context.Item.PrimaryKey)
					{
						<MudChip T="string" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mr-1">
							<strong>@kv.Key</strong>: @kv.Value
						</MudChip>
					}
				}
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.UserId" Title="@L[_currentDto.GetMemberDisplayName(x => x.UserId)]">
			<CellTemplate>
				<UserActionInfo User="@context.Item.Owner"
								ActionTime="@context.Item.DateTime" TimeZoneId="@UserProfile?.TimeZoneId">
				</UserActionInfo>
			</CellTemplate>
		</PropertyColumn>
	</Columns>
	<ChildRowContent>
		<MudCard Elevation="0" Class="pa-2">
			<MudCardContent>
				<MudText Typo="Typo.overline" Class="ml-2">@L["Modifications in"] @context.Item.TableName?.ToLower()</MudText>
				<MudDivider Class="mb-2" />

				<MudSimpleTable Hover="false" Dense Elevation="0" Bordered="false">
					<thead>
						<tr>
							<th>@L["Date"]</th>
							<th>@L["Field Name"]</th>
							<th>@L["Old Values"]</th>
							<th>@L["New Values"]</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var change in context.Item.Changes ?? new Dictionary<string, AuditChange>())
						{
							<tr>
								<td><UtcToLocal Typo="Typo.body2" Class="mud-text-secondary" UTCDateTime="@context.Item.DateTime"></UtcToLocal></td>
								<td><MudText Typo="Typo.body2">@change.Key</MudText></td>
								<td><MudText Typo="Typo.body2" Class="mud-text-secondary">@change.Value?.Old</MudText></td>
								<td><MudText Typo="Typo.body2">@change.Value?.New</MudText></td>
							</tr>
						}
					</tbody>
				</MudSimpleTable>
			</MudCardContent>
		</MudCard>
	</ChildRowContent>
	<NoRecordsContent>
		<MudDataGridStatus Icon="@Icons.Material.TwoTone.ReceiptLong"
						   Text="@L["No Audit Trails Found"]"
						   SubText="@L["Try adjusting your search or filter to find what you're looking for."]" />
	</NoRecordsContent>
	<LoadingContent>
		<MudDataGridStatus IsLoading="true"
						   Text="@L["Loading Audit Trails..."]" />
	</LoadingContent>
	<PagerContent>
		<MudDataGridPager PageSizeOptions="@(new[] { 10, 15, 30, 50, 100, 500, 1000 })" />
	</PagerContent>
</MudDataGrid>
</MudPaper>

@code {
	// Public page title
	public string Title { get; private set; } = "Audit Trails";

	// Private fields using underscore and camelCase naming
	private MudDataGrid<AuditTrailDto> _auditTrailGrid = null!;
	private List<BreadcrumbItem> _breadcrumbItems = [];
	private bool _loading;
	private int _defaultPageSize = 15;
	private readonly AuditTrailDto _currentDto = new();

	// _auditTrailsQuery parameters for pagination; using PascalCase for public properties and _camelCase for private fields
	private AuditTrailsWithPaginationQuery _auditTrailsQuery { get; } = new();

    private UserProfile UserProfile => UserProfileState.Value;
	private AuditTrailsAccessRights _accessRights = new();

	protected override async Task OnInitializedAsync()
	{
		// Set page title based on current DTO's class description
		Title = $"{ApplicationSettings.AppName} - {L[_currentDto.GetClassDescription()]}";
		_breadcrumbItems =
		[
			new BreadcrumbItem(L["Application"], href: null),
			new BreadcrumbItem(L["System"], href: null),
			new BreadcrumbItem(L[_currentDto.GetClassDescription()], href: null, disabled: true)
		];
		_accessRights = await PermissionService.GetAccessRightsAsync<AuditTrailsAccessRights>();
	}

	// Server data loading callback for the grid
	private async Task<GridData<AuditTrailDto>> ServerReload(GridState<AuditTrailDto> state, CancellationToken cancellationToken)
	{
		try
		{
			_loading = true;
			_auditTrailsQuery.CurrentUser = UserProfile;
			_auditTrailsQuery.OrderBy = state.SortDefinitions.FirstOrDefault()?.SortBy ?? "Id";
			var sortDefinition = state.SortDefinitions.FirstOrDefault();
			_auditTrailsQuery.SortDirection = sortDefinition == null
									  ? SortDirection.Descending.ToString()
									  : (sortDefinition.Descending ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString());
			_auditTrailsQuery.PageNumber = state.Page + 1;
			_auditTrailsQuery.PageSize = state.PageSize;
			var result = await Mediator.Send(_auditTrailsQuery).ConfigureAwait(false);
			return new GridData<AuditTrailDto> { TotalItems = result.TotalItems, Items = result.Items };
		}
		finally
		{
			_loading = false;
		}
	}

	// Event handler for when the list view is changed
	private async Task OnListViewChanged(AuditTrailListView listview)
	{
		_auditTrailsQuery.ListView = listview;
		await _auditTrailGrid.ReloadServerData();
	}

	// Event handler for keyword search
	private async Task OnKeywordSearch(string text)
	{
		_auditTrailsQuery.Keyword = text;
		await _auditTrailGrid.ReloadServerData();
	}

	// Event handler for audit type search
	private async Task OnAuditTypeSearch(AuditType? auditType)
	{
		_auditTrailsQuery.AuditType = auditType;
		await _auditTrailGrid.ReloadServerData();
	}

	// Refresh callback
	private async Task OnRefreshAuditTrails()
	{
		await AppCache.RemoveByTagsAsync(AuditTrailsCacheKey.Tags);
		_auditTrailsQuery.Keyword = string.Empty;
		await _auditTrailGrid.ReloadServerData();
	}

	// Toggle detail view for a specific audit trail
	private Task OnToggleDetail(AuditTrailDto dto)
	{
		dto.ShowDetails = !dto.ShowDetails;
		return Task.CompletedTask;
	}
}
